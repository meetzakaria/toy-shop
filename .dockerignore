# Build context hygiene: everything here is either rebuilt inside the image,
# irrelevant to the build, or must never be baked into a shipped layer.

# Installed inside the image by `npm ci` — copying the host tree would carry
# platform-specific binaries (sharp, swc) compiled for the wrong libc.
node_modules
.pnp
.pnp.*

# Build output — regenerated by `next build` in the builder stage.
.next
out
build
*.tsbuildinfo
next-env.d.ts

# Secrets. .env.local holds a real RootCart key; it must not enter a layer.
# Build-time values arrive as --build-arg instead.
.env
.env.*
!.env.example

# VCS and tooling
.git
.gitignore
.github
.vscode
.idea
.vercel

# Docs and agent files — not needed to build or run
*.md
!README.md

# Local noise
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage
Dockerfile
Dockerfile.*
.dockerignore
