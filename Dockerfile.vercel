# syntax=docker/dockerfile:1.7

# ---------------------------------------------------------------------------
# Vercel container deployment.
#
# Vercel deploys Next.js with its own build pipeline by default and ignores a
# plain `Dockerfile`. It only builds a container when the repository contains
# this exact filename — `Dockerfile.vercel` — in which case the image is built,
# stored and run on Fluid Compute instead.
#
# For a normal Next.js site the native pipeline is the better path (per-route
# functions, image optimisation, ISR). Use this file when the deployment must
# be a container: pinned system packages, a sidecar binary, or the same image
# running on Vercel and elsewhere.
#
# Environment: set NEXT_PUBLIC_ROOTCART_API, NEXT_PUBLIC_ROOTCART_KEY and
# NEXT_PUBLIC_SITE_URL in Project → Settings → Environment Variables. They are
# read at BUILD time (Next inlines NEXT_PUBLIC_ values into the browser
# bundle), so changing them requires a redeploy, not just a restart.
#
# Port: Vercel injects PORT. The server must bind it on 0.0.0.0 — never a fixed
# port, and never localhost.
# ---------------------------------------------------------------------------

ARG NODE_VERSION=22-alpine


# --------------------------------------------------------------- 1. deps -----
FROM node:${NODE_VERSION} AS deps
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci


# ------------------------------------------------------------- 2. builder ----
FROM node:${NODE_VERSION} AS builder
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Declared as ARGs so the same file also builds locally with --build-arg.
# On Vercel the project's environment variables populate them.
ARG NEXT_PUBLIC_ROOTCART_API=""
ARG NEXT_PUBLIC_ROOTCART_KEY=""
ARG NEXT_PUBLIC_SITE_URL=""

ENV NEXT_PUBLIC_ROOTCART_API=${NEXT_PUBLIC_ROOTCART_API} \
    NEXT_PUBLIC_ROOTCART_KEY=${NEXT_PUBLIC_ROOTCART_KEY} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build


# -------------------------------------------------------------- 3. runner ----
FROM node:${NODE_VERSION} AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

# Documentation only — the platform routes to whatever PORT it injects.
EXPOSE 3000

# PORT is left unset on purpose: Vercel supplies it, and Next's standalone
# server falls back to 3000 when running this image anywhere else.
CMD ["node", "server.js"]
